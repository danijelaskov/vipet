<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="5.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.askov.vipet.mvc.controllers.PerformanceMeasuresProviderController">
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
    <HBox alignment="CENTER" spacing="5.0">
        <ProgressBar fx:id="progressBar" prefWidth="300.0"/>
        <Label fx:id="progressLabel" minWidth="30.0"/>
    </HBox>
    <Label fx:id="elapsedTimeLabel"/>
</VBox>
