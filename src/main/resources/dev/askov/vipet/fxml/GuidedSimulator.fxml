<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="200.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.askov.vipet.mvc.controllers.GuidedSimulatorController">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <fx:include source="PerformanceMeasuresProvider.fxml"/>
        <Separator/>
        <TabPane fx:id="simulationsTabPane" tabClosingPolicy="UNAVAILABLE"/>
    </VBox>
</AnchorPane>
