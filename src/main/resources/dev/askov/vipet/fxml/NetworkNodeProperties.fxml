<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="resourcePropertiesVBox" prefWidth="500.0" stylesheets="@../css/main.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.askov.vipet.mvc.controllers.NetworkNodePropertiesController">
    <Accordion fx:id="resourcePropertiesAccordion" minHeight="500.0" prefHeight="500.0">
        <panes>
            <TitledPane text="%networkNodeProperties.general.title">
                <AnchorPane>
                    <GridPane alignment="CENTER" hgap="10.0" layoutX="27.6" layoutY="39.6" prefHeight="260.0"
                              prefWidth="410.0" vgap="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="10.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES"/>
                            <ColumnConstraints hgrow="SOMETIMES" percentWidth="70.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                            <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                            <RowConstraints maxHeight="30.0" minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10.0" prefHeight="110.0" vgrow="SOMETIMES"/>
                        </rowConstraints>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <Label alignment="CENTER" text="%networkNodeProperties.general.name"
                               GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                        <TextField fx:id="nameTextField" alignment="CENTER" GridPane.columnIndex="1"
                                   GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                            <opaqueInsets>
                                <Insets left="10.0" right="10.0"/>
                            </opaqueInsets>
                        </TextField>
                        <ColorPicker fx:id="fillColorPicker" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                                     GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                        <Label alignment="CENTER" text="%networkNodeProperties.general.fillColor"
                               GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                        <Label alignment="CENTER" text="%networkNodeProperties.general.strokeColor"
                               GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER"/>
                        <ColorPicker fx:id="strokeColorPicker" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                                     GridPane.rowIndex="2" GridPane.valignment="CENTER"/>
                        <TextArea fx:id="descriptionTextArea" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                                  GridPane.rowIndex="3" GridPane.valignment="CENTER">
                            <GridPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                            </GridPane.margin>
                        </TextArea>
                        <Label text="%networkNodeProperties.general.description" GridPane.halignment="CENTER"
                               GridPane.rowIndex="3" GridPane.valignment="CENTER"/>
                    </GridPane>
                </AnchorPane>
            </TitledPane>
            <TitledPane fx:id="queueTitledPane" expanded="false" text="%networkNodeProperties.queue.title">
                <AnchorPane>
                    <GridPane alignment="CENTER" hgap="10.0" vgap="5.0" AnchorPane.leftAnchor="0.0"
                              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="10.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES"/>
                            <ColumnConstraints hgrow="SOMETIMES"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints maxHeight="111.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES"/>
                            <RowConstraints maxHeight="111.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES"/>
                        </rowConstraints>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <Label alignment="CENTER" text="%networkNodeProperties.queue.capacity"
                               GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                        <AnchorPane GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                            <GridPane hgap="10.0" layoutY="2.0" vgap="5.0" AnchorPane.bottomAnchor="0.0"
                                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                                      AnchorPane.topAnchor="0.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES"/>
                                    <ColumnConstraints hgrow="SOMETIMES"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                </rowConstraints>
                                <RadioButton fx:id="infiniteRadioButton" mnemonicParsing="false"
                                             text="%networkNodeProperties.queue.capacity.infinite"
                                             GridPane.halignment="LEFT" GridPane.valignment="CENTER"/>
                                <RadioButton fx:id="finiteRadioButton" mnemonicParsing="false"
                                             text="%networkNodeProperties.queue.capacity.finite"
                                             GridPane.halignment="LEFT" GridPane.rowIndex="1"
                                             GridPane.valignment="CENTER"/>
                                <Spinner fx:id="queueCapacitySpinner" editable="true" GridPane.columnIndex="1"
                                         GridPane.halignment="CENTER" GridPane.rowIndex="1"
                                         GridPane.valignment="CENTER"/>
                            </GridPane>
                        </AnchorPane>
                        <Label text="%networkNodeProperties.queue.discipline" GridPane.halignment="CENTER"
                               GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                        <ChoiceBox fx:id="queueDisciplineChoiceBox" GridPane.columnIndex="1"
                                   GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                    </GridPane>
                </AnchorPane>
            </TitledPane>
            <TitledPane fx:id="serviceTitledPane" expanded="false" text="%networkNodeProperties.service.title">
                <AnchorPane>
                    <GridPane alignment="CENTER" hgap="10.0" vgap="5.0" AnchorPane.leftAnchor="0.0"
                              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="5.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES"/>
                            <ColumnConstraints hgrow="SOMETIMES"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints maxHeight="111.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES"/>
                            <RowConstraints maxHeight="111.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES"/>
                        </rowConstraints>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <Label alignment="CENTER" text="%networkNodeProperties.service.numberOfServers"
                               GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                        <Spinner fx:id="numberOfServersSpinner" editable="true" style="-fx-alignment: center;"
                                 GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                        <Label alignment="CENTER" text="%networkNodeProperties.service.timeDistribution"
                               GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                        <AnchorPane GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1"
                                    GridPane.valignment="CENTER">
                            <HBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0"
                                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                <ChoiceBox fx:id="serviceTimeDistributionChoiceBox" prefWidth="200.0"/>
                                <Button mnemonicParsing="false" onAction="#onEditTimeDistributionParameters"
                                        text="..."/>
                            </HBox>
                        </AnchorPane>
                    </GridPane>
                </AnchorPane>
            </TitledPane>
            <TitledPane fx:id="jobGenerationTitledPane" expanded="false"
                        text="%networkNodeProperties.jobGeneration.title">
                <AnchorPane>
                    <GridPane alignment="CENTER" hgap="10.0" vgap="5.0" AnchorPane.leftAnchor="0.0"
                              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints maxHeight="111.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES"/>
                        </rowConstraints>
                        <padding>
                            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                        </padding>
                        <Label alignment="CENTER" text="%networkNodeProperties.jobGeneration.timeDistribution"
                               GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                        <AnchorPane GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
                            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0"
                                  AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                                  AnchorPane.topAnchor="0.0">
                                <ChoiceBox fx:id="interArrivalTimeDistributionChoiceBox" prefWidth="200.0"/>
                                <Button mnemonicParsing="false" onAction="#onEditTimeDistributionParameters"
                                        text="..."/>
                            </HBox>
                        </AnchorPane>
                    </GridPane>
                </AnchorPane>
            </TitledPane>
            <TitledPane fx:id="routesTitledPane" expanded="false" text="%networkNodeProperties.routing.title">
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <VBox spacing="10.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0"
                          AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="%networkNodeProperties.routing.strategy"/>
                            <ChoiceBox fx:id="routingStrategyChoiceBox" prefWidth="250.0"/>
                        </HBox>
                        <VBox fx:id="routesVBox" alignment="BOTTOM_LEFT" prefHeight="200.0" prefWidth="100.0"
                              spacing="10.0" VBox.vgrow="ALWAYS">
                            <TableView fx:id="routesTableView" editable="true">
                                <columns>
                                    <TableColumn fx:id="destinationNameTableColumn" maxWidth="1.7976931348623157E308"
                                                 minWidth="200.0" prefWidth="-1.0"
                                                 text="%networkNodeProperties.probabilityRouting.destination"/>
                                    <TableColumn fx:id="probabilityTableColumn" maxWidth="1.7976931348623157E308"
                                                 minWidth="-1.0" prefWidth="200.0"
                                                 text="%networkNodeProperties.probabilityRouting.probability"/>
                                </columns>
                            </TableView>
                            <CheckBox fx:id="usePercentageProbabilityCheckBox" mnemonicParsing="false"
                                      text="%networkNodeProperties.probabilityRouting.usePercentageProbability"/>
                        </VBox>
                    </VBox>
                </AnchorPane>
            </TitledPane>
        </panes>
    </Accordion>
</VBox>
