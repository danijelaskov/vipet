<?xml version="1.0" encoding="UTF-8"?>

<?import dev.askov.vipet.mvc.views.components.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>


<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dev.askov.vipet.mvc.controllers.distributions.HyperexponentialTimeDistributionPropertiesController">
    <VBox>
        <AnchorPane>
            <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
                <GridPane alignment="CENTER" hgap="10.0" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                    <TextField fx:id="probabilityTextField" alignment="CENTER" GridPane.columnIndex="1"/>
                    <TextField fx:id="rateTextField" alignment="CENTER" GridPane.columnIndex="1"
                               GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="2"
                          GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER">
                        <Label minWidth="50.0" text="%hyperexponentialTimeDistributionProperties.jobs">
                            <HBox.margin>
                                <Insets right="5.0"/>
                            </HBox.margin>
                        </Label>
                        <Label text="/">
                            <HBox.margin>
                                <Insets right="10.0"/>
                            </HBox.margin>
                        </Label>
                        <ChoiceBox fx:id="rateTimeUnitChoiceBox" prefWidth="150.0"/>
                    </HBox>
                    <TextField fx:id="scaleTextField" alignment="CENTER" GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>
                    <ChoiceBox fx:id="scaleTimeUnitChoiceBox" prefWidth="150.0" GridPane.columnIndex="2"
                               GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER"/>
                    <LaTeXEquation pickOnBounds="true" preserveRatio="true" text="p" GridPane.halignment="CENTER"
                                   GridPane.valignment="CENTER"/>
                    <LaTeXEquation pickOnBounds="true" preserveRatio="true" text="\\lambda"
                                   GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
                    <LaTeXEquation pickOnBounds="true" preserveRatio="true" text="\\bar{s}=1/\lambda"
                                   GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER"/>
                </GridPane>
                <Button mnemonicParsing="false" onAction="#onAdd"
                        text="%hyperexponentialTimeDistributionProperties.add">
                    <graphic>
                        <FontIcon iconLiteral="codicon-add" iconSize="24" styleClass="menu-item-icon"/>
                    </graphic>
                </Button>
                <TableView fx:id="parametersTableView" editable="true">
                    <columns>
                        <TableColumn fx:id="indexTableColumn" editable="false" maxWidth="1.7976931348623157E308"
                                     minWidth="-1.0" prefWidth="100.0"
                                     text="%hyperexponentialTimeDistributionProperties.index"/>
                        <TableColumn fx:id="probabilityTableColumn" maxWidth="1.7976931348623157E308"
                                     minWidth="-1.0" prefWidth="200.0"
                                     text="%hyperexponentialTimeDistributionProperties.probability"/>
                        <TableColumn fx:id="rateTableColumn" maxWidth="1.7976931348623157E308" minWidth="-1.0"
                                     prefWidth="200.0" text="%hyperexponentialTimeDistributionProperties.rate"/>
                    </columns>
                </TableView>
            </VBox>
        </AnchorPane>
    </VBox>
    <Separator/>
    <AnchorPane>
        <fx:include source="TimeDistributionDetails.fxml" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
    </AnchorPane>
</VBox>
