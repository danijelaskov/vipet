<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dev.askov.vipet.mvc.controllers.SimulatorParametersController">
    <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <GridPane hgap="10.0" vgap="5.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <Label alignment="CENTER" text="%simulatorParameters.numberOfRuns" GridPane.halignment="CENTER"
                   GridPane.valignment="CENTER"/>
            <Spinner fx:id="numberOfRunsSpinner" editable="true" maxWidth="1.7976931348623157E308"
                     GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
            <Label text="%simulatorParameters.maxDuration" GridPane.halignment="CENTER" GridPane.rowIndex="1"
                   GridPane.valignment="CENTER"/>
            <HBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                  GridPane.rowIndex="1" GridPane.valignment="CENTER">
                <TextField fx:id="maxDurationTextField" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                <ChoiceBox fx:id="maxDurationUnitChoiceBox" prefWidth="100.0"/>
            </HBox>
            <Label alignment="CENTER" text="%simulatorParameters.maxSimulatedTime" GridPane.halignment="CENTER"
                   GridPane.rowIndex="2" GridPane.valignment="CENTER"/>
            <HBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                  GridPane.rowIndex="2" GridPane.valignment="CENTER">
                <TextField fx:id="maxSimulatedTimeTextField" alignment="CENTER" maxWidth="1.7976931348623157E308"
                           HBox.hgrow="ALWAYS"/>
                <ChoiceBox fx:id="maxSimulatedTimeUnitChoiceBox" prefWidth="100.0"/>
            </HBox>
            <Label alignment="CENTER" text="%simulatorParameters.maxSampleSize" GridPane.halignment="CENTER"
                   GridPane.rowIndex="3" GridPane.valignment="CENTER"/>
            <Spinner fx:id="maxSampleSizeSpinner" editable="true" maxWidth="1.7976931348623157E308"
                     GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label alignment="CENTER" text="%simulatorParameters.maxNumberOfEvents" GridPane.halignment="CENTER"
                   GridPane.rowIndex="4" GridPane.valignment="CENTER"/>
            <Spinner fx:id="maxNumberOfEventsSpinner" editable="true" maxWidth="1.7976931348623157E308"
                     GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <Label text="%simulatorParameters.randomGenerator" GridPane.halignment="CENTER" GridPane.rowIndex="5"
                   GridPane.valignment="CENTER"/>
            <Label text="%simulatorParameters.seed" GridPane.halignment="CENTER" GridPane.rowIndex="6"
                   GridPane.valignment="CENTER"/>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="5.0" GridPane.columnIndex="1"
                  GridPane.rowIndex="5">
                <ChoiceBox fx:id="randomGeneratorChoiceBox" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#onRandomGeneratorInfo">
                    <graphic>
                        <FontIcon iconLiteral="codicon-info" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%simulatorParameters.info.tooltip"/>
                    </tooltip>
                </Button>
            </HBox>
            <HBox alignment="CENTER" spacing="5.0" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                  GridPane.rowIndex="6" GridPane.valignment="CENTER">
                <Spinner fx:id="seedSpinner" editable="true" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#onRandomSeed">
                    <graphic>
                        <FontIcon iconLiteral="codicon-refresh" iconSize="18"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="%simulatorParameters.randomSeed.tooltip"/>
                    </tooltip>
                </Button>
            </HBox>
            <Label text="%simulator.discardedMeasurementsPercentage" GridPane.halignment="CENTER" GridPane.rowIndex="7"
                   GridPane.valignment="CENTER"/>
            <TextField fx:id="sampleDiscardRatioTextField" alignment="CENTER" GridPane.columnIndex="1"
                       GridPane.rowIndex="7"/>
            <Label text="%simulator.confidenceLevel" GridPane.halignment="CENTER" GridPane.rowIndex="8"
                   GridPane.valignment="CENTER"/>
            <TextField fx:id="confidenceLevelTextField" alignment="CENTER" GridPane.columnIndex="1"
                       GridPane.rowIndex="8"/>
        </GridPane>
        <Separator fx:id="additionalParametersSeparator" prefWidth="200.0"/>
        <VBox alignment="CENTER" prefHeight="250.0" spacing="10.0">
            <Label fx:id="initialNumberOfJobsExplanationLabel"/>
            <TableView fx:id="jobDistributionTableView" editable="true" prefHeight="300.0">
                <columns>
                    <TableColumn fx:id="resourceNameTableColumn" editable="false" minWidth="200.0" prefWidth="-1.0"
                                 text="%simulatorParameters.serviceCenter.name"/>
                    <TableColumn fx:id="initialNumberOfJobsTableColumn" minWidth="100.0" prefWidth="-1.0"
                                 text="%simulatorParameters.serviceCenter.numberOfJobs"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
